trustyaiServiceImage=quay.io/opendatahub/trustyai-service:odh-3.6-ea1
trustyaiOperatorImage=quay.io/opendatahub/trustyai-service-operator:odh-3.6-ea1
evalHubImage=quay.io/evalhub/evalhub:odh-3.6-ea1
evalHubMCPImage=quay.io/evalhub/evalhub:odh-3.6-ea1
kube-rbac-proxy=quay.io/opendatahub/odh-kube-rbac-proxy:odh-stable
kServeServerless=enabled
lmes-driver-image=quay.io/opendatahub/ta-lmes-driver:odh-3.6-ea1
lmes-pod-image=quay.io/opendatahub/ta-lmes-job:odh-3.6-ea1
lmes-pod-checking-interval=10s
lmes-image-pull-policy=Always
lmes-max-batch-size=24
lmes-default-batch-size=8
lmes-detect-device=true
lmes-allow-online=true
lmes-allow-code-execution=true
