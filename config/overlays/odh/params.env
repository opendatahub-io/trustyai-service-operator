trustyaiServiceImage=quay.io/opendatahub/trustyai-service:odh-3.5
trustyaiOperatorImage=quay.io/opendatahub/trustyai-service-operator:odh-3.5
evalHubImage=quay.io/opendatahub/odh-eval-hub:odh-3.5
evalHubMCPImage=quay.io/opendatahub/odh-eval-hub:odh-3.5
kube-rbac-proxy=quay.io/opendatahub/odh-kube-rbac-proxy:odh-stable
kServeServerless=enabled
lmes-driver-image=quay.io/opendatahub/ta-lmes-driver:odh-3.5
lmes-pod-image=quay.io/opendatahub/ta-lmes-job:odh-3.5-ga
lmes-pod-checking-interval=10s
lmes-image-pull-policy=Always
lmes-max-batch-size=24
lmes-default-batch-size=8
lmes-detect-device=true
lmes-allow-online=true
lmes-allow-code-execution=true
guardrails-orchestrator-image=quay.io/opendatahub/ta-guardrails-orchestrator:latest
guardrails-built-in-detector-image=quay.io/opendatahub/odh-built-in-detector:odh-3.5
guardrails-sidecar-gateway-image=quay.io/opendatahub/vllm-orchestrator-gateway:odh-3.5
ragas-provider-image=quay.io/opendatahub/llama-stack-provider-ragas:latest
garak-provider-image=quay.io/opendatahub/odh-trustyai-garak-lls-provider-dsp:odh-3.5
nemo-guardrails-image=quay.io/trustyai/nemo-guardrails-server:latest
evalhub-provider-guidellm-image=quay.io/evalhub/community-guidellm:latest
evalhub-provider-lighteval-image=quay.io/evalhub/community-lighteval:latest
evalhub-provider-ibm-clear-image=quay.io/evalhub/community-ibm-clear:latest
evalhub-provider-ragas-image=quay.io/evalhub/community-ragas:latest
evalhub-provider-deepeval-image=quay.io/evalhub/community-deepeval:latest
